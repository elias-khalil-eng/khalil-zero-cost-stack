# Copy to .env and fill in. Never commit the filled-in .env — it is git-ignored.
# The same keys go into Netlify → Site configuration → Environment variables.

# --- required ---------------------------------------------------------------

# Id from the sheet URL: docs.google.com/spreadsheets/d/THIS_PART/edit
SPREADSHEET_ID=

# The ENTIRE service-account JSON key, on one line.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# 32+ random characters. Rotating this signs everyone out.
JWT_SECRET=

# First-run admin. Change the password after the first login.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# --- optional ---------------------------------------------------------------

# Google Form URL for the "+ New Reservation" button target.
FORM_URL=

# Old form-responses spreadsheet id, for Admin → Import.
IMPORT_SPREADSHEET_ID=

# Origin used to build bride links (/fill/:token). Leave blank to use the site's
# own Netlify URL. Set it only when the form lives on a separate custom domain.
CLIENT_PUBLIC_ORIGIN=

# Lifetime of a generated bride link, in hours. 1-720, defaults to 72.
CLIENT_DRAFT_EXPIRY_HOURS=
